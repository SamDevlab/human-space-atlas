{
  "name": "human-space-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "node server/index.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "perf:catalog": "node scripts/benchmark-orbit.mjs",
    "perf:browser": "node scripts/benchmark-browser.mjs",
    "perf:browser:headed": "node scripts/benchmark-browser-headed.mjs",
    "smoke:earth": "node scripts/smoke-earth-visual.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check:server": "node --check server/index.mjs && node --check server/app.mjs && node --check server/cache.mjs && node --check scripts/dev.mjs"
  },
  "dependencies": {
    "cesium": "^1.143.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "satellite.js": "^7.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-cesium": "^1.2.23",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
