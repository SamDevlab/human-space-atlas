# URL do proxy/API local. No desenvolvimento, o padrão é http://localhost:8787
VITE_API_BASE_URL=http://localhost:8787

# Opcional: use seu próprio token Cesium ion caso habilite assets do ion.
VITE_CESIUM_ION_TOKEN=

# Cache persistente local do backend. Em desenvolvimento, o padrão é
# .cache/human-space-atlas; em Vercel sem KV, o fallback usa /tmp.
HSA_CACHE_DIR=
HSA_CACHE_DISABLE_DISK=0
HSA_CACHE_MEMORY_MAX_ENTRIES=256

# Rate limiting do backend. /api/horizons usa um orçamento separado e menor.
# X-Forwarded-For só é aceito quando HSA_TRUST_PROXY=1 ou no ambiente Vercel.
# Quando KV/Upstash abaixo está configurado, o contador passa a ser distribuído
# entre instâncias/cold starts. Se o backend remoto falhar, o servidor mantém
# proteção local em memória em vez de ficar ilimitado.
HSA_RATE_LIMIT_PER_MINUTE=180
HSA_HORIZONS_RATE_LIMIT_PER_MINUTE=30
HSA_RATE_LIMIT_MAX_CLIENTS=2048
HSA_RATE_LIMIT_REDIS_TIMEOUT_MS=1200
HSA_TRUST_PROXY=0

# Opcional e recomendado em produção/serverless: Upstash Redis REST ou
# Vercel KV compatível. O mesmo backend atende cache remoto e rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=
