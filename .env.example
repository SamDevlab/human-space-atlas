# URL do proxy/API local. No desenvolvimento, o padrão é http://localhost:8787
VITE_API_BASE_URL=http://localhost:8787

# Opcional: use seu próprio token Cesium ion caso habilite assets do ion.
VITE_CESIUM_ION_TOKEN=

# Cache persistente local do backend. Em desenvolvimento, o padrão é
# .cache/human-space-atlas; em Vercel sem KV, o fallback usa /tmp.
HSA_CACHE_DIR=
HSA_CACHE_DISABLE_DISK=0

# Opcional e recomendado em produção/serverless: Upstash Redis REST ou
# Vercel KV compatível. O servidor detecta automaticamente qualquer um dos
# pares abaixo e mantém stale-while-revalidate entre cold starts.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=
